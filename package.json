{
  "name": "@workos/emulate",
  "version": "0.3.0",
  "type": "module",
  "description": "Local WorkOS API emulator for tests and development",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workos/emulate.git"
  },
  "keywords": [
    "workos",
    "emulator",
    "authkit",
    "sso",
    "testing"
  ],
  "bin": {
    "workos-emulate": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./workos": {
      "import": "./dist/workos/index.js",
      "types": "./dist/workos/index.d.ts"
    }
  },
  "dependencies": {
    "@hono/node-server": "^1",
    "chalk": "^5.6.2",
    "hono": "^4",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "~22.19.7",
    "@workos/openapi-spec": "^0.41.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "clean": "rm -rf ./dist",
    "build": "rm -rf ./dist && tsc && chmod +x ./dist/cli.js",
    "start": "bun ./dist/cli.js",
    "dev": "bun src/cli.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "gen:routes": "bun scripts/gen-routes.ts",
    "gen:events": "bun scripts/gen-events.ts",
    "gen:shapes": "bun scripts/gen-shapes.ts",
    "check:coverage": "bun scripts/check-coverage.ts",
    "prepare": "husky"
  },
  "author": "WorkOS",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
